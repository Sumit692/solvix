# ==============================================================================
# MAPBOX (Required for 3D Terrain & Map Visualization)
# ==============================================================================
NEXT_PUBLIC_MAPBOX_TOKEN=
MAPBOX_TOKEN=

# ==============================================================================
# AI SIMULATION & AGENT (Azure OpenAI client used in lib/gemini.ts)
# ==============================================================================
GEMINI_API_KEY=
GEMINI_ENDPOINT=https://your-resource-name.openai.azure.com/
GEMINI_API_VERSION=2024-08-01-preview
GEMINI_MODEL=gpt-4o

# ==============================================================================
# SUPABASE AUTH (Email/Password authentication)
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ==============================================================================
# AUTH0 (Google OAuth & M2M Token Verification)
# ==============================================================================
NEXT_PUBLIC_AUTH0_DOMAIN=your-tenant.us.auth0.com
NEXT_PUBLIC_AUTH0_CLIENT_ID=
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# ==============================================================================
# APPLICATION URL (Set to your Vercel deployment URL or custom domain)
# ==============================================================================
NEXT_PUBLIC_APP_URL=https://solvix.vercel.app
APP_BASE_URL=https://solvix.vercel.app

# ==============================================================================
# OPTIONAL: UTILITY TARIFF & ROOF SEGMENTATION (Have local fallback estimates)
# ==============================================================================
UTILITY_TARIFF_API_KEY=
UTILITY_TARIFF_API_URL=
ROOF_SEGMENTATION_API_KEY=
ROOF_SEGMENTATION_API_URL=
ROOF_SEGMENTATION_PROVIDER=mapbox

# ==============================================================================
# MOBILE APP (Only needed for mobile/ Expo app)
# ==============================================================================
ELEVENLABS_AGENT_ID=
